# Generic S3-compatible object storage
S3_ENDPOINT=http://rustfs:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BUCKET=warehouse
S3_ACCESS_KEY=lakehouseadmin
S3_SECRET_KEY=lakehouseadmin
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
S3_SSL_ENABLED=false

# AWS SDK compatibility
AWS_JAVA_V1_DISABLE_DEPRECATION_ANNOUNCEMENT=true

# Polaris local development credentials
POLARIS_CLIENT_ID=admin
POLARIS_CLIENT_SECRET=password
POLARIS_URI=http://polaris:8181/api/catalog
POLARIS_OAUTH2_TOKEN_URL=http://polaris:8181/api/catalog/v1/oauth/tokens
POLARIS_PUBLIC_HEALTH_URL=http://localhost:8182/q/health
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL
POLARIS_WAREHOUSE=polaris

# Host-facing Spark Thrift check
DBT_SPARK_PUBLIC_HOST=localhost

# Iceberg warehouse path (data files)
ICEBERG_WAREHOUSE=s3://warehouse/polaris

# Spark worker instellingen
SPARK_WORKER_MEMORY=8G
SPARK_WORKER_CORES=6

PYTHON_VERSION=3.11

# SPARK_JARS_PACKAGES=org.apache.iceberg:iceberg-spark-runtime-3.5_2.12:1.10.0,org.apache.iceberg:iceberg-aws-bundle:1.10.0

HADOOP_VERSION=3.3.4
AWS_SDK_VERSION=1.12.783
